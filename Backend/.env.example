PORT=5000
NODE_ENV=development

# LLM provider: "ollama" (local dev) or "openai_compatible" (approved hosted endpoint on PrimeCloud)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
# Only for openai_compatible. Store as a server-side secret; never commit.
LLM_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=600
LLM_NUM_CTX=8192
LLM_KEEP_ALIVE=30m

# --- Hosted (e.g. Groq) — uncomment and replace the block above ---
# Note: the Groq base URL is .../openai/v1 (not .../qwen/v1)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_REASONING_EFFORT=none
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_FALLBACK_REASONING_EFFORT=low
# LLM_API_KEY=            # set as a server-side secret, never commit
# LLM_TIMEOUT_MS=30000

# Quota protection for /api/ask: questions per minute per client, and answer cache lifetime
ASK_RATE_LIMIT=10
ANSWER_CACHE_TTL_MS=900000
# Set to 1 behind a reverse proxy (PrimeCloud) so rate limits use the real client IP
# TRUST_PROXY=1

# Evidence gate: share of question terms that must appear in the retrieved passages
RETRIEVAL_MIN_COVERAGE=0.6
# Optional absolute BM25 floor. Off by default: scores depend on corpus size, so coverage is the gate.
RETRIEVAL_MIN_SCORE=0

# Enables ?simulate=model|retrieval on /api/ask for the failure-handling demo
DEMO_FAILURES=false
# Private per-user documents (main page upload): on unless set to false. In memory only, never on disk.
ALLOW_PRIVATE_UPLOADS=true
SESSION_TTL_MS=3600000
MAX_SESSIONS=200

# Shared knowledge base admin: enables POST/DELETE /api/documents (add/remove plain-text documents)
ALLOW_UPLOADS=false
# Required header x-upload-token for uploads/removals. SET THIS on any public deployment.
UPLOAD_TOKEN=
MAX_UPLOADED_DOCS=20
# Where uploaded originals are stored (use a persistent volume in production)
# UPLOAD_DIR=/data/uploads
